PRINTER = "/dev/usb/lp0"
PRINTER_MODEL = "QL-570"       # cf: venv/bin/brother_ql info models
DEFAULT_PRINT_SIZE = "large"   # 'large' or 'small'

# Obtained from https://github.com/makew0rld/didder/releases/tag/v1.3.0
# You want the 64-bit version on regular computers
# or the arm64 if you're deploying stickers.local on an ARM board
DIDDER_BIN = "assets/didder_1.3.0_linux_64-bit"

# $ venv/bin/brother_ql info labels
# Name      Printable px   Description
# 12         106           12mm endless
# 29         306           29mm endless
# 38         413           38mm endless
# 50         554           50mm endless
# 54         590           54mm endless
# 62         696           62mm endless
# 102       1164           102mm endless
LABEL = 62
LABEL_IDEAL_PIXEL_SIZE = 696

# If you want to enable the print queue system, you will need to
# toggle this to 'true', and probably 'apt install redis-server'
USE_QUEUE = false

TAGS = "foo,bar"
