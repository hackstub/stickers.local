# Development -> we use the JS magic thingy
curl -sL https://cdn.tailwindcss.com?plugins=forms > tailwind-css.js

# HTMX
curl -sL https://cdn.jsdelivr.net/npm/htmx.org@4.0.0 > htmx.min.js

# Icons from https://icones.js.org/collection/mdi
mkdir -p icons
for ICON in ph:check-circle-bold ph:circle-notch-bold ph:warning-diamond-bold ph:heart-bold ph:printer-bold ph:x-bold ph:pencil-simple-bold ph:floppy-disk-back-bold ph:magnifying-glass-bold ph:stack-bold
do
    curl -sL https://api.iconify.design/$ICON.svg > icons/$ICON.svg
done

# Shantell Sans font
curl -sL https://github.com/arrowtype/shantell-sans/releases/download/1.011/Shantell_Sans_1.011.zip > Shantell_Sans.zip
unzip Shantell_Sans.zip "*Shantell_Sans-Normal-*.woff2" -d ./.tmp
mv .tmp/*/Web/Static/*.woff2 ./
rm *_Italic.woff2
rm Shantell_Sans.zip
