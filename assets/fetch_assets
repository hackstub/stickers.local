# HTMX
curl -sL https://cdn.jsdelivr.net/npm/htmx.org@4.0.0 > htmx.min.js

# Icons from https://icones.js.org/collection/mdi
mkdir -p icons
ICONS="
ph:check-circle-bold
ph:circle-notch-bold
ph:warning-diamond-bold
ph:heart-bold
ph:printer-bold
ph:x-bold
ph:pencil-simple-bold
ph:floppy-disk-back-bold
ph:magnifying-glass-bold
ph:stack-bold
"
for ICON in $ICONS
do
    #curl -sL https://api.iconify.design/$ICON.svg > icons/$ICON.svg
    # Stupid api.iconify may ban you in which can you need to :
    curl -L https://raw.githubusercontent.com/phosphor-icons/core/main/raw/bold/${ICON#ph:}.svg > icons/$ICON.svg
done

# Shantell Sans font
curl -sL https://github.com/arrowtype/shantell-sans/releases/download/1.011/Shantell_Sans_1.011.zip > Shantell_Sans.zip
unzip Shantell_Sans.zip "*Shantell_Sans-Normal-*.woff2" -d ./.tmp
mv .tmp/*/Web/Static/*.woff2 ./
rm *_Italic.woff2
rm Shantell_Sans.zip
